<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Product Manager (React)</masterLabel>
    <description>Embeds the React Product Manager app (CRUD on Product2) in an iframe.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="appUrl" type="String" label="App URL" description="Overrides the Product_App_URL custom label." />
            <property name="height" type="Integer" label="Height (px)" default="720" />
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="appUrl" type="String" label="App URL" description="Overrides the Product_App_URL custom label." />
            <property name="height" type="Integer" label="Height (px)" default="720" />
            <objects>
                <object>Product2</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
