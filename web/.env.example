# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local.

# Leave VITE_SF_CLIENT_ID empty (or set VITE_DATA_MODE=demo) to run with in-browser demo data.
VITE_DATA_MODE=

# Consumer key of the External Client App (OAuth, PKCE). Public value, not a secret.
VITE_SF_CLIENT_ID=

# Your org's My Domain URL, e.g. https://yourdomain-dev-ed.develop.my.salesforce.com
VITE_SF_LOGIN_URL=

# Salesforce REST API version
VITE_SF_API_VERSION=v68.0
